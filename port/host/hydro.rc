#include <winver.h>

// Version (CMakeLists.txt project() VERSION), shown in Explorer's Details tab.
VS_VERSION_INFO VERSIONINFO
FILEVERSION HYDRO_VERSION_MAJOR, HYDRO_VERSION_MINOR, HYDRO_VERSION_PATCH, 0
PRODUCTVERSION HYDRO_VERSION_MAJOR, HYDRO_VERSION_MINOR, HYDRO_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Hydro Thunder for Windows"
            VALUE "FileVersion", HYDRO_VERSION
            VALUE "InternalName", "hydro"
            VALUE "OriginalFilename", "hydro.exe"
            VALUE "ProductName", "Hydro Thunder for Windows"
            VALUE "ProductVersion", HYDRO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Resource 1 is the application icon (Explorer, taskbar); window.c and disk_setup.c load it by id.
1 ICON "../../assets/icon.ico"

// The port's player tracking markers 9-16 (markers.h: id = MARKERS_RESOURCE_BASE + marker number).
109 RCDATA "../../assets/markers/marker09.png"
110 RCDATA "../../assets/markers/marker10.png"
111 RCDATA "../../assets/markers/marker11.png"
112 RCDATA "../../assets/markers/marker12.png"
113 RCDATA "../../assets/markers/marker13.png"
114 RCDATA "../../assets/markers/marker14.png"
115 RCDATA "../../assets/markers/marker15.png"
116 RCDATA "../../assets/markers/marker16.png"
